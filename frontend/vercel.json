{
  "rewrites": [
    {
      "source": "/step1/:code",
      "destination": "/api/track/step1/:code"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/step1.html",
      "destination": "/frontend/public/step1.html"
    },
    {
      "source": "/step2.html",
      "destination": "/frontend/public/step2.html"
    },
    {
      "source": "/step3.html",
      "destination": "/frontend/public/step3.html"
    },
    {
      "source": "/step4.html",
      "destination": "/frontend/public/step4.html"
    },
    {
      "source": "/final.html",
      "destination": "/frontend/public/final.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}